# ==============================================================================
# Sri Lanka Local Services Finder — Environment Configuration Template
# ==============================================================================
# This template contains placeholders only. Never commit real credentials.
# Configure these variables in Vercel Project Settings (Development, Preview, Production).

# ------------------------------------------------------------------------------
# 1. Public Application Configuration (Exposed to browser)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ------------------------------------------------------------------------------
# 2. Server-Only Supabase Credentials (NEVER prefix with NEXT_PUBLIC_)
# ------------------------------------------------------------------------------
# Elevated Supabase service key for administrative server operations
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Direct database connection string for migrations (Optional/CLI only)
# SUPABASE_DB_URL=postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 3. Storage Provider Configuration (Server only)
# ------------------------------------------------------------------------------
# Choose active storage provider: 'vultr' (if credits confirmed) or 'supabase'
STORAGE_PROVIDER=supabase

# Vultr S3-compatible Object Storage (Active when STORAGE_PROVIDER=vultr)
VULTR_S3_ENDPOINT=https://sgp1.vultrobjects.com
VULTR_S3_REGION=us-east-1
VULTR_S3_ACCESS_KEY=your-vultr-s3-access-key
VULTR_S3_SECRET_KEY=your-vultr-s3-secret-key
VULTR_PUBLIC_MEDIA_BUCKET=lsf-public-media
VULTR_PRIVATE_FILES_BUCKET=lsf-private-files
VULTR_PUBLIC_MEDIA_BASE_URL=

# Supabase Storage fallback (Active when STORAGE_PROVIDER=supabase)
SUPABASE_PUBLIC_MEDIA_BUCKET=public-media
SUPABASE_PRIVATE_FILES_BUCKET=private-files

# ------------------------------------------------------------------------------
# 4. Optional Third-Party Services (Feature flagged)
# ------------------------------------------------------------------------------
# Maps & Geolocation (Browser-restricted API key only)
# NEXT_PUBLIC_MAP_PROVIDER=
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Error Monitoring (Sentry)
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
