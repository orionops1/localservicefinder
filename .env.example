# ==============================================================================
# Sri Lanka Local Services Finder — Environment Configuration Template
# ==============================================================================
# This file contains placeholders only. Never commit real secrets or .env.local.
# Maintain separate values for local development, Vercel Preview, and V2 production.

# ------------------------------------------------------------------------------
# 1. Application & Public Client Configuration
# ------------------------------------------------------------------------------
# Fully qualified public URL of the application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Values intentionally exposed to the browser (publishable, not secret)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ------------------------------------------------------------------------------
# 2. Server-Only Runtime Secrets (NEVER prefix with NEXT_PUBLIC_)
# ------------------------------------------------------------------------------
# Elevated Supabase service key for administrative server operations
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Direct database connection string for migrations / backups (Server only)
# SUPABASE_DB_URL=postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 3. File Storage Configuration
# ------------------------------------------------------------------------------
# Active storage provider: 'supabase' for V1 testing, 'vultr-s3' for V2 production
STORAGE_PROVIDER=supabase

# V1 Supabase Storage buckets
SUPABASE_STORAGE_PUBLIC_BUCKET=provider-public
SUPABASE_STORAGE_PRIVATE_BUCKET=private-documents

# V2 Vultr Object Storage (Reserved for M7/M8 — do not configure in V1)
# VULTR_S3_ENDPOINT=https://sgp1.vultrobjects.com
# VULTR_S3_REGION=us-east-1
# VULTR_S3_ACCESS_KEY=
# VULTR_S3_SECRET_KEY=
# VULTR_PUBLIC_MEDIA_BUCKET=lsf-public-media
# VULTR_PRIVATE_FILES_BUCKET=lsf-private-files
# VULTR_BACKUP_BUCKET=lsf-backups
# VULTR_PUBLIC_MEDIA_BASE_URL=

# ------------------------------------------------------------------------------
# 4. Optional Third-Party Services (Feature flagged)
# ------------------------------------------------------------------------------
# Transactional Email (Resend)
# RESEND_API_KEY=
# EMAIL_FROM_ADDRESS=noreply@localservicefinder.lk

# Maps & Geolocation (Browser-restricted API key only)
# NEXT_PUBLIC_MAP_PROVIDER=
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Error Monitoring (Sentry)
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
